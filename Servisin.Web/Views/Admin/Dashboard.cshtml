@{
    ViewData["Title"] = "Dashboard Overview";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Metrics Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Active Tickets -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow duration-200">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-medium text-slate-500">Active Tickets</h3>
            <div class="p-2 bg-blue-50 rounded-lg">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
            </div>
        </div>
        <p class="text-3xl font-bold text-[#0F172A]">24</p>
        <p class="text-xs text-green-600 mt-2 font-medium flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
            12% vs last week
        </p>
    </div>

    <!-- Today's Revenue -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow duration-200">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-medium text-slate-500">Today's Revenue</h3>
            <div class="p-2 bg-green-50 rounded-lg">
                <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </div>
        <p class="text-3xl font-bold text-[#0F172A]">Rp 4.2M</p>
        <p class="text-xs text-green-600 mt-2 font-medium flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
            8% vs yesterday
        </p>
    </div>

    <!-- Low Stock Parts -->
    <div class="bg-white rounded-xl border border-orange-200 p-6 shadow-sm hover:shadow-md transition-shadow duration-200 relative overflow-hidden">
        <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-orange-400 to-red-600"></div>
        <div class="flex items-center justify-between mb-4 mt-1">
            <h3 class="text-sm font-medium text-slate-500">Low Stock Parts</h3>
            <div class="p-2 bg-orange-50 rounded-lg">
                <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
            </div>
        </div>
        <p class="text-3xl font-bold text-[#0F172A]">7</p>
        <p class="text-xs text-orange-600 mt-2 font-medium">Requires attention</p>
    </div>

    <!-- AI Success Rate -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow duration-200">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-medium text-slate-500">AI Success Rate</h3>
            <div class="p-2 bg-purple-50 rounded-lg">
                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
        </div>
        <p class="text-3xl font-bold text-[#0F172A]">94.2%</p>
        <p class="text-xs text-slate-500 mt-2 font-medium">Last 30 days accuracy</p>
    </div>
</div>

<!-- Data Table: Recent AI Triage Requests -->
<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-[#0F172A]">Recent AI Triage Requests</h2>
        <button class="text-sm font-medium text-[#0369A1] hover:text-[#0F172A] transition-colors duration-200 cursor-pointer">
            View All
        </button>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="bg-[#F8FAFC] text-slate-500 font-medium border-b border-gray-100">
                <tr>
                    <th class="px-6 py-4">Date</th>
                    <th class="px-6 py-4">Customer Name</th>
                    <th class="px-6 py-4">Device Model</th>
                    <th class="px-6 py-4">Estimated Cost</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <!-- Row 1 -->
                <tr class="hover:bg-gray-50 transition-colors duration-150">
                    <td class="px-6 py-4 text-slate-500">Today, 09:41 AM</td>
                    <td class="px-6 py-4 font-medium text-[#0F172A]">Budi Santoso</td>
                    <td class="px-6 py-4 text-slate-600">iPhone 13 Pro Max</td>
                    <td class="px-6 py-4 font-medium">Rp 450.000</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                            Pending
                        </span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <button class="text-[#0369A1] hover:underline font-medium text-sm cursor-pointer">Review</button>
                    </td>
                </tr>
                <!-- Row 2 -->
                <tr class="hover:bg-gray-50 transition-colors duration-150">
                    <td class="px-6 py-4 text-slate-500">Today, 08:15 AM</td>
                    <td class="px-6 py-4 font-medium text-[#0F172A]">Siti Aminah</td>
                    <td class="px-6 py-4 text-slate-600">Samsung S22 Ultra</td>
                    <td class="px-6 py-4 font-medium">Rp 1.200.000</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            Approved
                        </span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <button class="text-[#0369A1] hover:underline font-medium text-sm cursor-pointer">Review</button>
                    </td>
                </tr>
                <!-- Row 3 -->
                <tr class="hover:bg-gray-50 transition-colors duration-150">
                    <td class="px-6 py-4 text-slate-500">Yesterday, 14:20 PM</td>
                    <td class="px-6 py-4 font-medium text-[#0F172A]">Rizky Pratama</td>
                    <td class="px-6 py-4 text-slate-600">MacBook Air M1</td>
                    <td class="px-6 py-4 font-medium">Rp 850.000</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            Approved
                        </span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <button class="text-[#0369A1] hover:underline font-medium text-sm cursor-pointer">Review</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
