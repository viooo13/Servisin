@{
    ViewData["Title"] = "Register - Servisin";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/tailwind.output.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-[#F8FAFC] min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden relative">
        <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-[#0F172A] to-[#0369A1]"></div>
        <div class="p-8">
            <div class="text-center mb-8">
                <h1 class="text-2xl font-bold text-[#0F172A] tracking-tight">Create Account</h1>
                <p class="text-sm text-slate-500 mt-2">Join SERVISIN PRO today</p>
            </div>

            <form method="post" asp-action="Register" asp-controller="Auth" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Full Name</label>
                    <input type="text" name="name" required class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#0369A1]/20 focus:border-[#0369A1] transition-all" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Email Address</label>
                    <input type="email" name="email" required class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#0369A1]/20 focus:border-[#0369A1] transition-all" />
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
                    <input type="password" name="password" required class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#0369A1]/20 focus:border-[#0369A1] transition-all" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Confirm Password</label>
                    <input type="password" name="confirmPassword" required class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#0369A1]/20 focus:border-[#0369A1] transition-all" />
                </div>

                <button type="submit" class="w-full bg-[#0F172A] text-white py-2.5 rounded-lg text-sm font-medium hover:bg-[#1e293b] transition-colors shadow-sm cursor-pointer mt-4">
                    Register
                </button>
            </form>

            <div class="mt-6 text-center text-sm text-slate-500">
                Already have an account? <a href="/Auth/Login" class="font-medium text-[#0369A1] hover:underline">Sign In</a>
            </div>
        </div>
    </div>

</body>
</html>
